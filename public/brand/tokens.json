{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "brand": {
    "color": {
      "plum": { "900": { "$type": "color", "$value": "#402239" } },
      "rose": {
        "600": { "$type": "color", "$value": "#A84D68" },
        "400": { "$type": "color", "$value": "#C77D94" }
      },
      "coral": { "500": { "$type": "color", "$value": "#E97F91" } },
      "ivory": { "50": { "$type": "color", "$value": "#FFF9FA" } },
      "charcoal": { "950": { "$type": "color", "$value": "#171417" } },
      "neutral": {
        "600": { "$type": "color", "$value": "#6F666C" },
        "200": { "$type": "color", "$value": "#E8E1E4" }
      },
      "success": { "600": { "$type": "color", "$value": "#2F7A5F" } },
      "info": { "600": { "$type": "color", "$value": "#2B6CB0" } },
      "warning": { "600": { "$type": "color", "$value": "#B56B15" } },
      "danger": { "600": { "$type": "color", "$value": "#B73B4C" } },
      "focus": { "600": { "$type": "color", "$value": "#2E7D72" } }
    },
    "font": {
      "sans": { "$type": "fontFamily", "$value": ["DM Sans", "Arial", "sans-serif"] },
      "display": { "$type": "fontFamily", "$value": ["DM Serif Display", "Georgia", "serif"] }
    },
    "radius": {
      "small": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
      "medium": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
      "large": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } }
    },
    "motion": {
      "fast": { "$type": "duration", "$value": { "value": 180, "unit": "ms" } },
      "base": { "$type": "duration", "$value": { "value": 300, "unit": "ms" } },
      "brand": { "$type": "duration", "$value": { "value": 600, "unit": "ms" } }
    }
  }
}
