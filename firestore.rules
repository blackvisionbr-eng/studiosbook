rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserScope(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/{entityName}/{documentId} {
      allow read, create, update, delete: if ownsUserScope(userId);
    }

    match /users/{userId} {
      allow read, create, update, delete: if ownsUserScope(userId);
    }
  }
}
