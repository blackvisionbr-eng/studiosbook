rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserScope(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isPlatformAdmin() {
      return signedIn() && request.auth.token.platform_admin == true;
    }

    function hasActiveAccess(userId) {
      return isPlatformAdmin() || (
        exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.access_allowed == true &&
        (
          get(/databases/$(database)/documents/users/$(userId)).data.billing_status == 'authorized' ||
          get(/databases/$(database)/documents/users/$(userId)).data.access_expires_at > request.time
        )
      );
    }

    match /users/{userId}/{entityName}/{documentId} {
      allow read: if ownsUserScope(userId);
      allow create, update, delete: if ownsUserScope(userId) &&
        entityName != 'BillingSubscription' &&
        entityName != 'BillingPayment' &&
        hasActiveAccess(userId);
    }

    match /users/{userId} {
      allow read: if ownsUserScope(userId);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
